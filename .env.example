# ------------------------------------------------------------------
# ZBuilder Admin Panel - environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to git.
# ------------------------------------------------------------------

# --- Port (Render sets this automatically; local dev default is 3000) ---
PORT=3000

# --- GitHub "database" -----------------------------------------------
# Repo that holds ad-config.json  (e.g. advik08k/ZBuilder-Plugins)
GITHUB_OWNER=advik08k
GITHUB_REPO=ZBuilder-Plugins
GITHUB_BRANCH=main
CONFIG_PATH=ad-config.json

# Personal Access Token (classic) with `repo` scope.
# https://github.com/settings/tokens  -> Generate classic token -> check "repo"
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- Admin dashboard login --------------------------------------------
# Password an admin types into the dashboard login box.
ADMIN_PASSWORD=change-me-to-something-long

# Any long random string. Used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Set to "production" on Render (enables the Secure flag on the cookie)
NODE_ENV=production
